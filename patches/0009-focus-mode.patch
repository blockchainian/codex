+/// Tool activity that focus mode keeps out of the main view; the transcript still retains it.
+fn is_hidden_activity(cell: &dyn HistoryCell) -> bool {
+    let cell = cell.as_any();
+    cell.downcast_ref::<crate::exec_cell::ExecCell>()
+        .is_some_and(|cell| !cell.iter_calls().any(|call| call.is_user_shell_command()))
+        || cell.is::<history_cell::PatchHistoryCell>()
+        || cell.is::<history_cell::ViewImageHistoryCell>()
+        || cell.is::<history_cell::McpToolCallCell>()
+        || cell.is::<history_cell::DynamicToolCallCell>()
+        || cell.is::<history_cell::WebSearchCell>()
+        || cell.is::<history_cell::ComputerActivityCell>()
+}
+
 impl App {
+    /// Main-view lines for a committed cell, empty for activity hidden by focus mode.
+    pub(super) fn scrollback_lines(
+        &self,
+        cell: &dyn HistoryCell,
+        width: u16,
+    ) -> Vec<HyperlinkLine> {
+        if self.chat_widget.focus_mode && is_hidden_activity(cell) {
+            return Vec::new();
+        }
+        cell.display_hyperlink_lines_for_mode(width, self.chat_widget.history_render_mode())
+    }
