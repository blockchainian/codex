diff --git a/codex-rs/core/tests/suite/websocket_fallback.rs b/codex-rs/core/tests/suite/websocket_fallback.rs
index f2d8d494ae..283e4a990a 100644
--- a/codex-rs/core/tests/suite/websocket_fallback.rs
+++ b/codex-rs/core/tests/suite/websocket_fallback.rs
@@ -299,3 +299,44 @@ async fn websocket_fallback_is_sticky_across_turns() -> Result<()> {
 
     Ok(())
 }
+
+#[test_case::test_case(false; "failed_response")]
+#[test_case::test_case(true; "wrapped_http_error")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn server_overload_retry_reuses_websocket_connection(wrapped: bool) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let error = serde_json::json!({
+        "code": "server_is_overloaded",
+        "message": "Selected model is at capacity. Please try a different model."
+    });
+    let overload = if wrapped {
+        serde_json::json!({"type": "error", "status": 503, "error": error})
+    } else {
+        serde_json::json!({"type": "response.failed", "response": {"error": error}})
+    };
+    let server = responses::start_websocket_server(vec![
+        vec![
+            vec![ev_response_created("warm"), ev_completed("warm")],
+            vec![overload.clone()],
+            vec![overload],
+            vec![ev_response_created("ok"), ev_completed("ok")],
+        ],
+        vec![vec![
+            ev_response_created("reconnected"),
+            ev_completed("reconnected"),
+        ]],
+    ])
+    .await;
+    let test = test_codex()
+        .with_config(|config| {
+            config.model_provider.stream_max_retries = Some(0);
+            config.model_provider.request_max_retries = Some(0);
+        })
+        .build_with_websocket_server(&server)
+        .await?;
+    test.submit_turn("hello").await?;
+    assert_eq!(server.connections().len(), 1);
+    assert_eq!(server.single_connection().len(), 4);
+    server.shutdown().await;
+    Ok(())
+}
