@@ -138,11 +146,67 @@ impl Default for StatusState {
             retry_status_header: None,
             pending_status_indicator_restore: false,
             thread_title_generation_pending: false,
+            session_api_seconds: 0,
+            session_started_at: None,
+            session_response_ids: std::collections::HashSet::new(),
         }
     }
 }
 
 impl StatusState {
+    pub(super) fn record_response(
+        &mut self,
+        id: String,
+        metadata: Option<serde_json::Value>,
+    ) -> bool {
+        let Some(seconds) =
+            metadata.and_then(|metadata| metadata["_codex_session_api_seconds"].as_u64())
+        else {
+            return false;
+        };
+        if !self.session_response_ids.insert(id) {
+            return false;
+        }
+        self.session_api_seconds = self.session_api_seconds.saturating_add(seconds);
+        true
+    }
+
+    pub(super) fn restore_session_time(&mut self, rollout_path: Option<&Path>) -> io::Result<()> {
+        self.session_started_at = None;
+        self.session_api_seconds = 0;
+        self.session_response_ids.clear();
+        let Some(path) = rollout_path else {
+            return Ok(());
+        };
+        let file = codex_rollout::open_rollout_seekable_reader(path)?;
+        let mut saw_meta = false;
+        for line in std::io::BufReader::new(file).lines() {
+            let line = line?;
+            if !line.contains("\"session_meta\"") && !line.contains("\"raw_response_completed\"") {
+                continue;
+            }
+            match codex_rollout::parse_rollout_line(&line).map(|line| line.item) {
+                Ok(RolloutItem::SessionMeta(meta)) if !saw_meta => {
+                    saw_meta = true;
+                    self.session_started_at = Some(
+                        chrono::DateTime::parse_from_rfc3339(&meta.meta.timestamp)
+                            .map_err(io::Error::other)?
+                            .timestamp(),
+                    );
+                }
+                Ok(RolloutItem::EventMsg(EventMsg::RawResponseCompleted(event))) => {
+                    self.record_response(
+                        event.response_id,
+                        event.usage_metadata.and_then(|usage| usage.metadata),
+                    );
+                }
+                Ok(_) => {}
+                Err(err) => tracing::warn!(%err, "invalid session time record"),
+            }
+        }
+        Ok(())
+    }
+
     pub(super) fn set_status(&mut self, status: StatusIndicatorState) {
         self.current_status = status;
     }
