+    pub(crate) fn toggle_subagents(&mut self, view_id: &'static str) -> bool {
+        if self.bottom_pane.dismiss_active_view_if_id(view_id) {
+            self.on_modal_or_popup_closed();
+        } else if self.bottom_pane.no_modal_or_popup_active() {
